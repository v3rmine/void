
{ pkgs, lib, ... }:

{


  # Containers
  virtualisation.oci-containers.containers."silverbullet-silverbullet" = {
    image = "ghcr.io/silverbulletmd/silverbullet:2.9.0";
    environmentFiles = [
      "/persist/etc/silverbullet.env"
    ];
    volumes = [
      "silverbullet-data:/space:rw"
    ];
    ports = [
      "63008:3000/tcp"
    ];
    log-driver = "journald";
    extraOptions = [
      "--network-alias=silverbullet"
      "--network=silverbullet_default"
    ];
  };
  systemd.services."docker-silverbullet-silverbullet" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
      RestartMaxDelaySec = lib.mkOverride 90 "1m";
      RestartSec = lib.mkOverride 90 "100ms";
      RestartSteps = lib.mkOverride 90 9;
    };
    after = [
      "docker-network-silverbullet_default.service"
      "docker-volume-silverbullet_silverbullet-data.service"
    ];
    requires = [
      "docker-network-silverbullet_default.service"
      "docker-volume-silverbullet_silverbullet-data.service"
    ];
    partOf = [
      "docker-compose-silverbullet-root.target"
    ];
    wantedBy = [
      "docker-compose-silverbullet-root.target"
    ];
  };

  # Networks
  systemd.services."docker-network-silverbullet_default" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "docker network rm -f silverbullet_default";
    };
    script = ''
      docker network inspect silverbullet_default || docker network create silverbullet_default
    '';
    partOf = [ "docker-compose-silverbullet-root.target" ];
    wantedBy = [ "docker-compose-silverbullet-root.target" ];
  };

  # Volumes
  systemd.services."docker-volume-silverbullet_silverbullet-data" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      docker volume inspect silverbullet-data || docker volume create silverbullet-data
    '';
    partOf = [ "docker-compose-silverbullet-root.target" ];
    wantedBy = [ "docker-compose-silverbullet-root.target" ];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."docker-compose-silverbullet-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = [ "multi-user.target" ];
  };
}
