
{ pkgs, lib, ... }:

{


  # Containers
  virtualisation.oci-containers.containers."coturn-coturn" = {
    image = "coturn/coturn:4.17.2";
    volumes = [
      "coturn_config:/etc/coturn:rw"
    ];
    ports = [
      "3478:3478/tcp"
      "3478:3478/udp"
      "5349:5349/tcp"
      "5349:5349/udp"
      "49160:49160/udp"
      "49161:49161/udp"
      "49162:49162/udp"
      "49163:49163/udp"
      "49164:49164/udp"
      "49165:49165/udp"
      "49166:49166/udp"
      "49167:49167/udp"
      "49168:49168/udp"
      "49169:49169/udp"
      "49170:49170/udp"
    ];
    cmd = [ "--min-port=49160" "--max-port=49170" ];
    user = "977:977";
    log-driver = "journald";
    extraOptions = [
      "--network-alias=coturn"
      "--network=coturn_default"
    ];
  };
  systemd.services."docker-coturn-coturn" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
      RestartMaxDelaySec = lib.mkOverride 90 "1m";
      RestartSec = lib.mkOverride 90 "100ms";
      RestartSteps = lib.mkOverride 90 9;
    };
    after = [
      "docker-network-coturn_default.service"
      "docker-volume-coturn_coturn_config.service"
    ];
    requires = [
      "docker-network-coturn_default.service"
      "docker-volume-coturn_coturn_config.service"
    ];
    partOf = [
      "docker-compose-coturn-root.target"
    ];
    wantedBy = [
      "docker-compose-coturn-root.target"
    ];
  };

  # Networks
  systemd.services."docker-network-coturn_default" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "docker network rm -f coturn_default";
    };
    script = ''
      docker network inspect coturn_default || docker network create coturn_default
    '';
    partOf = [ "docker-compose-coturn-root.target" ];
    wantedBy = [ "docker-compose-coturn-root.target" ];
  };

  # Volumes
  systemd.services."docker-volume-coturn_coturn_config" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      docker volume inspect coturn_config || docker volume create coturn_config
    '';
    partOf = [ "docker-compose-coturn-root.target" ];
    wantedBy = [ "docker-compose-coturn-root.target" ];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."docker-compose-coturn-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = [ "multi-user.target" ];
  };
}
