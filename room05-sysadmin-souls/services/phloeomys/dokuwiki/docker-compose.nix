
{ pkgs, lib, ... }:

{


  # Containers
  virtualisation.oci-containers.containers."dokuwiki-dokuwiki" = {
    image = "dokuwiki/dokuwiki:stable";
    volumes = [
      "dokuwiki-data:/storage:rw"
    ];
    ports = [
      "63003:8080/tcp"
    ];
    user = "1001:1001";
    log-driver = "journald";
    extraOptions = [
      "--network-alias=dokuwiki"
      "--network=dokuwiki_default"
    ];
  };
  systemd.services."docker-dokuwiki-dokuwiki" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
      RestartMaxDelaySec = lib.mkOverride 90 "1m";
      RestartSec = lib.mkOverride 90 "100ms";
      RestartSteps = lib.mkOverride 90 9;
    };
    after = [
      "docker-network-dokuwiki_default.service"
      "docker-volume-dokuwiki_dokuwiki-data.service"
    ];
    requires = [
      "docker-network-dokuwiki_default.service"
      "docker-volume-dokuwiki_dokuwiki-data.service"
    ];
    partOf = [
      "docker-compose-dokuwiki-root.target"
    ];
    wantedBy = [
      "docker-compose-dokuwiki-root.target"
    ];
  };

  # Networks
  systemd.services."docker-network-dokuwiki_default" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "docker network rm -f dokuwiki_default";
    };
    script = ''
      docker network inspect dokuwiki_default || docker network create dokuwiki_default
    '';
    partOf = [ "docker-compose-dokuwiki-root.target" ];
    wantedBy = [ "docker-compose-dokuwiki-root.target" ];
  };

  # Volumes
  systemd.services."docker-volume-dokuwiki_dokuwiki-data" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      docker volume inspect dokuwiki-data || docker volume create dokuwiki-data
    '';
    partOf = [ "docker-compose-dokuwiki-root.target" ];
    wantedBy = [ "docker-compose-dokuwiki-root.target" ];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."docker-compose-dokuwiki-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = [ "multi-user.target" ];
  };
}
