
{ pkgs, lib, ... }:

{


  # Containers
  virtualisation.oci-containers.containers."continuwuity-continuwuity" = {
    image = "forgejo.ellis.link/continuwuation/continuwuity:latest-maxperf";
    ports = [
      "63002:6167/tcp"
    ];
    environment = {
      "CONTINUWUITY_ADDRESS" = "0.0.0.0";
      "CONTINUWUITY_ALLOW_CHECK_FOR_UPDATES" = "true";
      "CONTINUWUITY_ALLOW_FEDERATION" = "true";
      "CONTINUWUITY_ALLOW_INBOUND_PROFILE_LOOKUP_FEDERATION_REQUESTS" = "true";
      "CONTINUWUITY_ALLOW_INCOMING_PRESENCE" = "true";
      "CONTINUWUITY_ALLOW_LOCAL_PRESENCE" = "true";
      "CONTINUWUITY_ALLOW_OUTGOING_PRESENCE" = "true";
      "CONTINUWUITY_ALLOW_PUBLIC_ROOM_DIRECTORY_OVER_FEDERATION" = "true";
      "CONTINUWUITY_ALLOW_REGISTRATION" = "true";
      "CONTINUWUITY_DATABASE_PATH" = "/var/lib/continuwuity";
      "CONTINUWUITY_MAX_REQUEST_SIZE" = "20000000";
      "CONTINUWUITY_PORT" = "6167";
      "CONTINUWUITY_SERVER_NAME" = "m.v3rm.in";
      "CONTINUWUITY_TRUSTED_SERVERS" = "[\"matrix.org\"]";
      "CONTINUWUITY_WELL_KNOWN" = "{
    client=https://m.v3rm.in,
    server=m.v3rm.in:443
  }
  ";
    };
    volumes = [
      "continuwuity-data:/var/lib/continuwuity:rw"
    ];
    user = "1003:1003";
    log-driver = "journald";
    extraOptions = [
      "--network-alias=continuwuity"
      "--network=continuwuity_default"
    ];
  };
  systemd.services."docker-continuwuity-continuwuity" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
      RestartMaxDelaySec = lib.mkOverride 90 "1m";
      RestartSec = lib.mkOverride 90 "100ms";
      RestartSteps = lib.mkOverride 90 9;
    };
    after = [
      "docker-network-continuwuity_default.service"
      "docker-volume-continuwuity_continuwuity-data.service"
    ];
    requires = [
      "docker-network-continuwuity_default.service"
      "docker-volume-continuwuity_continuwuity-data.service"
    ];
    partOf = [
      "docker-compose-continuwuity-root.target"
    ];
    wantedBy = [
      "docker-compose-continuwuity-root.target"
    ];
  };

  # Networks
  systemd.services."docker-network-continuwuity_default" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "docker network rm -f continuwuity_default";
    };
    script = ''
      docker network inspect continuwuity_default || docker network create continuwuity_default
    '';
    partOf = [ "docker-compose-continuwuity-root.target" ];
    wantedBy = [ "docker-compose-continuwuity-root.target" ];
  };

  # Volumes
  systemd.services."docker-volume-continuwuity_continuwuity-data" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      docker volume inspect continuwuity-data || docker volume create continuwuity-data
    '';
    partOf = [ "docker-compose-continuwuity-root.target" ];
    wantedBy = [ "docker-compose-continuwuity-root.target" ];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."docker-compose-continuwuity-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = [ "multi-user.target" ];
  };
}
