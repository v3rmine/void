
{ pkgs, lib, ... }:

{


  # Containers
  virtualisation.oci-containers.containers."townsquare-townsquare" = {
    image = "localhost/compose2nix/townsquare-townsquare";
    environment = {
      "DATA_DIR" = "/data";
      "HOST" = "0.0.0.0";
      "INACTIVE_CHECK_INTERVAL_MS" = "60000";
      "INACTIVE_DISCONNECT_MS" = "1800000";
      "IP_CHAT_EVENT_LIMIT" = "20";
      "IP_JOIN_LIMIT" = "30";
      "IP_MAX_IDENTITIES" = "4";
      "IP_QUARANTINE_MS" = "600000";
      "IP_STATE_EVENT_LIMIT" = "600";
      "IP_SYNC_ACTION_ROUNDS" = "3";
      "IP_SYNC_ACTION_TOLERANCE_MS" = "250";
      "IP_SYNC_ACTION_WINDOW_MS" = "10000";
      "MAX_CONNECTIONS" = "100";
      "MIN_HUMAN_SAY_MS" = "1500";
      "PORT" = "8787";
      "POW_DIFFICULTY_BITS" = "15";
    };
    volumes = [
      "townsquare-data:/data:rw"
    ];
    ports = [
      "63007:8787/tcp"
    ];
    user = "0:0";
    log-driver = "journald";
    extraOptions = [
      "--network-alias=townsquare"
      "--network=townsquare_default"
    ];
    rootless = { user = "podman"; };
  };
  systemd.services."docker-townsquare-townsquare" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
      RestartMaxDelaySec = lib.mkOverride 90 "1m";
      RestartSec = lib.mkOverride 90 "100ms";
      RestartSteps = lib.mkOverride 90 9;
    };
    after = [
      "docker-network-townsquare_default.service"
      "docker-volume-townsquare_townsquare-data.service"
    ];
    requires = [
      "docker-network-townsquare_default.service"
      "docker-volume-townsquare_townsquare-data.service"
    ];
    partOf = [
      "docker-compose-townsquare-root.target"
    ];
    wantedBy = [
      "docker-compose-townsquare-root.target"
    ];
  };

  # Networks
  systemd.services."docker-network-townsquare_default" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "docker network rm -f townsquare_default";
    };
    script = ''
      docker network inspect townsquare_default || docker network create townsquare_default
    '';
    partOf = [ "docker-compose-townsquare-root.target" ];
    wantedBy = [ "docker-compose-townsquare-root.target" ];
  };

  # Volumes
  systemd.services."docker-volume-townsquare_townsquare-data" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      docker volume inspect townsquare-data || docker volume create townsquare-data
    '';
    partOf = [ "docker-compose-townsquare-root.target" ];
    wantedBy = [ "docker-compose-townsquare-root.target" ];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."docker-compose-townsquare-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = [ "multi-user.target" ];
  };
}
