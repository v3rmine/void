
{ pkgs, lib, ... }:

{


  # Containers
  virtualisation.oci-containers.containers."goatcounter" = {
    image = "arp242/goatcounter:latest";
    volumes = [
      "goatcounter-data:/home/goatcounter/goatcounter-data:rw"
    ];
    ports = [
      "63011:8080/tcp"
    ];
    user = "1000:1000";
    log-driver = "journald";
    extraOptions = [
      "--network-alias=goatcounter"
      "--network=goatcounter_default"
    ];
  };
  systemd.services."docker-goatcounter" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
      RestartMaxDelaySec = lib.mkOverride 90 "1m";
      RestartSec = lib.mkOverride 90 "100ms";
      RestartSteps = lib.mkOverride 90 9;
    };
    after = [
      "docker-network-goatcounter_default.service"
      "docker-volume-goatcounter_goatcounter-data.service"
    ];
    requires = [
      "docker-network-goatcounter_default.service"
      "docker-volume-goatcounter_goatcounter-data.service"
    ];
    partOf = [
      "docker-compose-goatcounter-root.target"
    ];
    wantedBy = [
      "docker-compose-goatcounter-root.target"
    ];
  };

  # Networks
  systemd.services."docker-network-goatcounter_default" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "docker network rm -f goatcounter_default";
    };
    script = ''
      docker network inspect goatcounter_default || docker network create goatcounter_default
    '';
    partOf = [ "docker-compose-goatcounter-root.target" ];
    wantedBy = [ "docker-compose-goatcounter-root.target" ];
  };

  # Volumes
  systemd.services."docker-volume-goatcounter_goatcounter-data" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      docker volume inspect goatcounter-data || docker volume create goatcounter-data
    '';
    partOf = [ "docker-compose-goatcounter-root.target" ];
    wantedBy = [ "docker-compose-goatcounter-root.target" ];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."docker-compose-goatcounter-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = [ "multi-user.target" ];
  };
}
