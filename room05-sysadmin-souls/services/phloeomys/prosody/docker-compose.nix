
{ pkgs, lib, ... }:

{


  # Containers
  virtualisation.oci-containers.containers."prosody-prosody" = {
    image = "prosodyim/prosody:13.0";
    environment = {
      "PROSODY_ADMINS" = "v3rmine@astriiid.fr";
      "PROSODY_VIRTUAL_HOSTS" = "astriiid.fr";
    };
    volumes = [
      "prosody_prosody-config:/etc/prosody:rw"
      "prosody_prosody-data:/var/lib/prosody:rw"
    ];
    ports = [
      "5222:5222/tcp"
      "5269:5269/tcp"
      "63013:5280/tcp"
    ];
    log-driver = "journald";
    extraOptions = [
      "--network-alias=prosody"
      "--network=prosody_default"
    ];
    rootless = { user = "podman"; };
  };
  systemd.services."docker-prosody-prosody" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
      RestartMaxDelaySec = lib.mkOverride 90 "1m";
      RestartSec = lib.mkOverride 90 "100ms";
      RestartSteps = lib.mkOverride 90 9;
    };
    after = [
      "docker-network-prosody_default.service"
      "docker-volume-prosody_prosody-config.service"
      "docker-volume-prosody_prosody-data.service"
    ];
    requires = [
      "docker-network-prosody_default.service"
      "docker-volume-prosody_prosody-config.service"
      "docker-volume-prosody_prosody-data.service"
    ];
    partOf = [
      "docker-compose-prosody-root.target"
    ];
    wantedBy = [
      "docker-compose-prosody-root.target"
    ];
  };

  # Networks
  systemd.services."docker-network-prosody_default" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "docker network rm -f prosody_default";
    };
    script = ''
      docker network inspect prosody_default || docker network create prosody_default
    '';
    partOf = [ "docker-compose-prosody-root.target" ];
    wantedBy = [ "docker-compose-prosody-root.target" ];
  };

  # Volumes
  systemd.services."docker-volume-prosody_prosody-config" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      docker volume inspect prosody_prosody-config || docker volume create prosody_prosody-config
    '';
    partOf = [ "docker-compose-prosody-root.target" ];
    wantedBy = [ "docker-compose-prosody-root.target" ];
  };
  systemd.services."docker-volume-prosody_prosody-data" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      docker volume inspect prosody_prosody-data || docker volume create prosody_prosody-data
    '';
    partOf = [ "docker-compose-prosody-root.target" ];
    wantedBy = [ "docker-compose-prosody-root.target" ];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."docker-compose-prosody-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = [ "multi-user.target" ];
  };
}
