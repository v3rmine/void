
{ pkgs, lib, ... }:

{


  # Containers
  virtualisation.oci-containers.containers."miniflux" = {
    image = "miniflux/miniflux:2.2.19";
    environment = {
      "DATABASE_URL" = "postgres://miniflux:secret@miniflux-db/miniflux?sslmode=disable";
      "RUN_MIGRATIONS" = "1";
    };
    ports = [
      "63005:8080/tcp"
    ];
    dependsOn = [
      "miniflux-miniflux-db"
    ];
    user = "1004:1004";
    log-driver = "journald";
    extraOptions = [
      "--network-alias=miniflux"
      "--network=miniflux_default"
    ];
  };
  systemd.services."docker-miniflux" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "no";
    };
    after = [
      "docker-network-miniflux_default.service"
    ];
    requires = [
      "docker-network-miniflux_default.service"
    ];
    partOf = [
      "docker-compose-miniflux-root.target"
    ];
    wantedBy = [
      "docker-compose-miniflux-root.target"
    ];
  };
  virtualisation.oci-containers.containers."miniflux-miniflux-db" = {
    image = "postgres:14";
    environment = {
      "POSTGRES_PASSWORD" = "secret";
      "POSTGRES_USER" = "miniflux";
      "ROOT_URL" = "https://rss.reta.re";
    };
    volumes = [
      "miniflux-data:/var/lib/postgresql/data:rw"
    ];
    log-driver = "journald";
    extraOptions = [
      "--health-cmd=[\"pg_isready\", \"-U\", \"miniflux\"]"
      "--health-interval=10s"
      "--health-start-period=30s"
      "--hostname=miniflux-db"
      "--network-alias=miniflux-db"
      "--network=miniflux_default"
    ];
  };
  systemd.services."docker-miniflux-miniflux-db" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "no";
    };
    after = [
      "docker-network-miniflux_default.service"
      "docker-volume-miniflux_miniflux-data.service"
    ];
    requires = [
      "docker-network-miniflux_default.service"
      "docker-volume-miniflux_miniflux-data.service"
    ];
    partOf = [
      "docker-compose-miniflux-root.target"
    ];
    wantedBy = [
      "docker-compose-miniflux-root.target"
    ];
  };

  # Networks
  systemd.services."docker-network-miniflux_default" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "docker network rm -f miniflux_default";
    };
    script = ''
      docker network inspect miniflux_default || docker network create miniflux_default
    '';
    partOf = [ "docker-compose-miniflux-root.target" ];
    wantedBy = [ "docker-compose-miniflux-root.target" ];
  };

  # Volumes
  systemd.services."docker-volume-miniflux_miniflux-data" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      docker volume inspect miniflux-data || docker volume create miniflux-data
    '';
    partOf = [ "docker-compose-miniflux-root.target" ];
    wantedBy = [ "docker-compose-miniflux-root.target" ];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."docker-compose-miniflux-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = [ "multi-user.target" ];
  };
}
