
{ pkgs, lib, ... }:

{


  # Containers
  virtualisation.oci-containers.containers."linkding-linkding" = {
    image = "ghcr.io/sissbruecker/linkding:latest-alpine";
    volumes = [
      "linkding-data:/etc/linkding/data:rw"
    ];
    ports = [
      "63010:9090/tcp"
    ];
    user = "0:0";
    log-driver = "journald";
    extraOptions = [
      "--network-alias=linkding"
      "--network=linkding_default"
    ];
    rootless = { user = "podman"; };
  };
  systemd.services."docker-linkding-linkding" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
      RestartMaxDelaySec = lib.mkOverride 90 "1m";
      RestartSec = lib.mkOverride 90 "100ms";
      RestartSteps = lib.mkOverride 90 9;
    };
    after = [
      "docker-network-linkding_default.service"
      "docker-volume-linkding_linkding-data.service"
    ];
    requires = [
      "docker-network-linkding_default.service"
      "docker-volume-linkding_linkding-data.service"
    ];
    partOf = [
      "docker-compose-linkding-root.target"
    ];
    wantedBy = [
      "docker-compose-linkding-root.target"
    ];
  };

  # Networks
  systemd.services."docker-network-linkding_default" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "docker network rm -f linkding_default";
    };
    script = ''
      docker network inspect linkding_default || docker network create linkding_default
    '';
    partOf = [ "docker-compose-linkding-root.target" ];
    wantedBy = [ "docker-compose-linkding-root.target" ];
  };

  # Volumes
  systemd.services."docker-volume-linkding_linkding-data" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      docker volume inspect linkding-data || docker volume create linkding-data
    '';
    partOf = [ "docker-compose-linkding-root.target" ];
    wantedBy = [ "docker-compose-linkding-root.target" ];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."docker-compose-linkding-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = [ "multi-user.target" ];
  };
}
