
{ pkgs, lib, ... }:

{


  # Containers
  virtualisation.oci-containers.containers."filestash" = {
    image = "machines/filestash:latest";
    environmentFiles = [ "/persist/etc/filestash.env" ];
    ports = [
      "63004:8334"
    ];
    volumes = [
      "filestash-config:/app/data/state:rw"
    ];
    user = "0:0";
    log-driver = "journald";
    extraOptions = [
      "--health-cmd=curl --silent --fail 127.0.0.1:8334 || exit 1"
      "--health-interval=10s"
      "--health-retries=5"
      "--health-timeout=5s"
      "--network-alias=filestash"
      "--network=filestash_default"
    ];
    rootless = { user = "podman"; };
  };
  systemd.services."docker-filestash" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "no";
    };
    after = [
      "docker-network-filestash_default.service"
      "docker-volume-filestash_filestash-config.service"
    ];
    requires = [
      "docker-network-filestash_default.service"
      "docker-volume-filestash_filestash-config.service"
    ];
    partOf = [
      "docker-compose-filestash-root.target"
    ];
    wantedBy = [
      "docker-compose-filestash-root.target"
    ];
  };

  # Networks
  systemd.services."docker-network-filestash_default" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "docker network rm -f filestash_default";
    };
    script = ''
      docker network inspect filestash_default || docker network create filestash_default
    '';
    partOf = [ "docker-compose-filestash-root.target" ];
    wantedBy = [ "docker-compose-filestash-root.target" ];
  };

  # Volumes
  systemd.services."docker-volume-filestash_filestash-config" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      docker volume inspect filestash-config || docker volume create filestash-config
    '';
    partOf = [ "docker-compose-filestash-root.target" ];
    wantedBy = [ "docker-compose-filestash-root.target" ];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."docker-compose-filestash-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = [ "multi-user.target" ];
  };
}
