
{ pkgs, lib, ... }:

{


  # Containers
  virtualisation.oci-containers.containers."pairdrop" = {
    image = "lscr.io/linuxserver/pairdrop:latest";
    environment = {
      "DEBUG_MODE" = "true";
      "PGID" = "1000";
      "PUID" = "1000";
      "RATE_LIMIT" = "false";
      "RTC_CONFIG" = "/config/rtc_config.json";
      "TZ" = "Europe/Paris";
      "WS_FALLBACK" = "false";
    };
    volumes = [
      "pairdrop-config:/config:rw"
    ];
    ports = [
      "63008:3000/tcp"
    ];
    log-driver = "journald";
    extraOptions = [
      "--network-alias=pairdrop"
      "--network=pairdrop_default"
    ];
    rootless = { user = "podman"; };
  };
  systemd.services."docker-pairdrop" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
      RestartMaxDelaySec = lib.mkOverride 90 "1m";
      RestartSec = lib.mkOverride 90 "100ms";
      RestartSteps = lib.mkOverride 90 9;
    };
    after = [
      "docker-network-pairdrop_default.service"
      "docker-volume-pairdrop_pairdrop-config.service"
    ];
    requires = [
      "docker-network-pairdrop_default.service"
      "docker-volume-pairdrop_pairdrop-config.service"
    ];
    partOf = [
      "docker-compose-pairdrop-root.target"
    ];
    wantedBy = [
      "docker-compose-pairdrop-root.target"
    ];
  };

  # Networks
  systemd.services."docker-network-pairdrop_default" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "docker network rm -f pairdrop_default";
    };
    script = ''
      docker network inspect pairdrop_default || docker network create pairdrop_default
    '';
    partOf = [ "docker-compose-pairdrop-root.target" ];
    wantedBy = [ "docker-compose-pairdrop-root.target" ];
  };

  # Volumes
  systemd.services."docker-volume-pairdrop_pairdrop-config" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      docker volume inspect pairdrop-config || docker volume create pairdrop-config
    '';
    partOf = [ "docker-compose-pairdrop-root.target" ];
    wantedBy = [ "docker-compose-pairdrop-root.target" ];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."docker-compose-pairdrop-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = [ "multi-user.target" ];
  };
}
