
{ pkgs, lib, ... }:

{


  # Containers
  virtualisation.oci-containers.containers."garage-cold" = {
    image = "dxflrs/garage:v2.1.0";
    environment = {
      "GARAGE_CONFIG_FILE" = "/var/lib/garage/meta/garage.toml";
    };
    volumes = [
      "/var/lib/rootless-podman/.local/share/docker/volumes/garage-cold-data:/var/lib/garage/data:rw"
      "garage-cold-meta:/var/lib/garage/meta:rw"
    ];
    ports = [
      "63004:3900/tcp"
    ];
    log-driver = "journald";
    extraOptions = [
      "--network-alias=garage-cold"
      "--network=garage-cold_default"
    ];
    rootless = { user = "podman"; };
  };
  systemd.services."docker-garage-cold" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
      RestartMaxDelaySec = lib.mkOverride 90 "1m";
      RestartSec = lib.mkOverride 90 "100ms";
      RestartSteps = lib.mkOverride 90 9;
    };
    after = [
      "docker-network-garage-cold_default.service"
      "docker-volume-garage-cold_garage-cold-meta.service"
    ];
    requires = [
      "docker-network-garage-cold_default.service"
      "docker-volume-garage-cold_garage-cold-meta.service"
    ];
    partOf = [
      "docker-compose-garage-cold-root.target"
    ];
    wantedBy = [
      "docker-compose-garage-cold-root.target"
    ];
  };

  # Networks
  systemd.services."docker-network-garage-cold_default" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "docker network rm -f garage-cold_default";
    };
    script = ''
      docker network inspect garage-cold_default || docker network create garage-cold_default
    '';
    partOf = [ "docker-compose-garage-cold-root.target" ];
    wantedBy = [ "docker-compose-garage-cold-root.target" ];
  };

  # Volumes
  systemd.services."docker-volume-garage-cold_garage-cold-meta" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      docker volume inspect garage-cold-meta || docker volume create garage-cold-meta
    '';
    partOf = [ "docker-compose-garage-cold-root.target" ];
    wantedBy = [ "docker-compose-garage-cold-root.target" ];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."docker-compose-garage-cold-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = [ "multi-user.target" ];
  };
}
