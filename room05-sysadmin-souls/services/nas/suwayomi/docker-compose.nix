
{ pkgs, lib, ... }:

{


  # Containers
  virtualisation.oci-containers.containers."flaresolverr" = {
    image = "ghcr.io/thephaseless/byparr:latest";
    environment = {
      "TZ" = "Europe/Paris";
    };
    log-driver = "journald";
    extraOptions = [
      "--network-alias=flaresolverr"
      "--network=suwayomi_default"
      "--no-healthcheck"
    ];
    rootless = { user = "podman"; };
  };
  systemd.services."docker-flaresolverr" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
      RestartMaxDelaySec = lib.mkOverride 90 "1m";
      RestartSec = lib.mkOverride 90 "100ms";
      RestartSteps = lib.mkOverride 90 9;
    };
    after = [
      "docker-network-suwayomi_default.service"
    ];
    requires = [
      "docker-network-suwayomi_default.service"
    ];
    partOf = [
      "docker-compose-suwayomi-root.target"
    ];
    wantedBy = [
      "docker-compose-suwayomi-root.target"
    ];
  };
  virtualisation.oci-containers.containers."suwayomi-suwayomi" = {
    image = "ghcr.io/suwayomi/suwayomi-server:preview";
    environment = {
      "FLARESOLVERR_ENABLED" = "true";
      "FLARESOLVERR_URL" = "http://flaresolverr:8191";
      "JAVA_TOOL_OPTIONS" = "-Xms256m -Xmx1g";
      "TZ" = "Europe/Paris";
    };
    volumes = [
      "suwayomi-data:/home/suwayomi/.local/share/Tachidesk:rw"
    ];
    ports = [
      "63009:4567/tcp"
    ];
    user = "0:0";
    log-driver = "journald";
    extraOptions = [
      "--memory=1073741824b"
      "--network-alias=suwayomi"
      "--network=suwayomi_default"
    ];
    rootless = { user = "podman"; };
  };
  systemd.services."docker-suwayomi-suwayomi" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "on-failure";
    };
    startLimitBurst = 3;
    unitConfig = {
      StartLimitIntervalSec = lib.mkOverride 90 "infinity";
    };
    after = [
      "docker-network-suwayomi_default.service"
      "docker-volume-suwayomi_suwayomi-data.service"
    ];
    requires = [
      "docker-network-suwayomi_default.service"
      "docker-volume-suwayomi_suwayomi-data.service"
    ];
    partOf = [
      "docker-compose-suwayomi-root.target"
    ];
    wantedBy = [
      "docker-compose-suwayomi-root.target"
    ];
  };

  # Networks
  systemd.services."docker-network-suwayomi_default" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "docker network rm -f suwayomi_default";
    };
    script = ''
      docker network inspect suwayomi_default || docker network create suwayomi_default
    '';
    partOf = [ "docker-compose-suwayomi-root.target" ];
    wantedBy = [ "docker-compose-suwayomi-root.target" ];
  };

  # Volumes
  systemd.services."docker-volume-suwayomi_suwayomi-data" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      docker volume inspect suwayomi-data || docker volume create suwayomi-data
    '';
    partOf = [ "docker-compose-suwayomi-root.target" ];
    wantedBy = [ "docker-compose-suwayomi-root.target" ];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."docker-compose-suwayomi-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = [ "multi-user.target" ];
  };
}
