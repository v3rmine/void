
{ pkgs, lib, config, ... }:

{


  # Containers
  virtualisation.oci-containers.containers."changedetection" = {
    image = "ghcr.io/dgtlmoon/changedetection.io:latest";
    environment = {
      "BASE_URL" = "https://change.serv4.reta.re";
      "DISABLE_VERSION_CHECK" = "true";
      "FETCH_WORKERS" = "2";
      "HIDE_REFERER" = "true";
      "PLAYWRIGHT_DRIVER_URL" = "ws://changedetection-puppet:3000";
      "TZ" = "Europe/Paris";
    };
    volumes = [
      "changedetection_data:/datastore:rw"
    ];
    ports = [
      "63002:5000/tcp"
    ];
    dependsOn = [
      "changedetection-changedetection-puppet"
    ];
    log-driver = "journald";
    extraOptions = [
      "--memory=1073741824b"
      "--network-alias=changedetection"
      "--network=changedetection_default"
    ];
    podman = { user = "podman"; };
  };
  systemd.services."podman-changedetection" = {
    serviceConfig = {
      User = "podman";
      Restart = lib.mkOverride 90 "no";
    };
    after = [
      "podman-network-changedetection_default.service"
      "podman-volume-changedetection_changedetection_data.service"
    ];
    requires = [
      "podman-network-changedetection_default.service"
      "podman-volume-changedetection_changedetection_data.service"
    ];
    partOf = [
      "podman-compose-changedetection-root.target"
    ];
    wantedBy = [
      "podman-compose-changedetection-root.target"
    ];
  };
  virtualisation.oci-containers.containers."changedetection-changedetection-puppet" = {
    image = "localhost/compose2nix/changedetection-changedetection-puppet";
    environment = {
      "MAX_CONCURRENT_CHROME_PROCESSES" = "2";
    };
    log-driver = "journald";
    extraOptions = [
      "--hostname=changedetection-puppet"
      "--memory=1073741824b"
      "--network-alias=changedetection-puppet"
      "--network=changedetection_default"
    ];
    podman = { user = "podman"; };
  };
  systemd.services."podman-changedetection-changedetection-puppet" = {
    serviceConfig = {
      User = "podman";
      Restart = lib.mkOverride 90 "always";
    };
    after = [
      "podman-network-changedetection_default.service"
    ];
    requires = [
      "podman-network-changedetection_default.service"
    ];
    partOf = [
      "podman-compose-changedetection-root.target"
    ];
    wantedBy = [
      "podman-compose-changedetection-root.target"
    ];
  };

  # Networks
  systemd.services."podman-network-changedetection_default" = {
    path = [ pkgs.podman ];
    serviceConfig = {
      User = "podman";
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "podman network rm -f changedetection_default";
    };
    script = ''
      podman network inspect changedetection_default || podman network create changedetection_default
    '';
    partOf = [ "podman-compose-changedetection-root.target" ];
    wantedBy = [ "podman-compose-changedetection-root.target" ];
  };

  # Volumes
  systemd.services."podman-volume-changedetection_changedetection_data" = {
    path = [ pkgs.podman ];
    serviceConfig = {
      User = "podman";
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      podman volume inspect changedetection_data || podman volume create changedetection_data
    '';
    partOf = [ "podman-compose-changedetection-root.target" ];
    wantedBy = [ "podman-compose-changedetection-root.target" ];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."podman-compose-changedetection-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = [ "multi-user.target" ];
  };
}
