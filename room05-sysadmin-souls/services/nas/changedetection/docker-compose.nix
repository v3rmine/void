
{ pkgs, lib, ... }:

{


  # Containers
  virtualisation.oci-containers.containers."changedetection" = {
    image = "ghcr.io/dgtlmoon/changedetection.io:latest";
    environment = {
      "BASE_URL" = "https://change.serv4.reta.re";
      "DISABLE_VERSION_CHECK" = "true";
      "FETCH_WORKERS" = "2";
      "HIDE_REFERER" = "true";
      "PLAYWRIGHT_DRIVER_URL" = "ws://changedetection-puppet:3000";
      "TZ" = "Europe/Paris";
    };
    volumes = [
      "changedetection_data:/datastore:rw"
    ];
    ports = [
      "63002:5000/tcp"
    ];
    dependsOn = [
      "changedetection-changedetection-puppet"
    ];
    log-driver = "journald";
    extraOptions = [
      "--memory=1073741824b"
      "--network-alias=changedetection"
      "--network=changedetection_default"
    ];
    rootless = { user = "podman"; };
  };
  systemd.services."docker-changedetection" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "no";
    };
    after = [
      "docker-network-changedetection_default.service"
      "docker-volume-changedetection_changedetection_data.service"
    ];
    requires = [
      "docker-network-changedetection_default.service"
      "docker-volume-changedetection_changedetection_data.service"
    ];
    partOf = [
      "docker-compose-changedetection-root.target"
    ];
    wantedBy = [
      "docker-compose-changedetection-root.target"
    ];
  };
  virtualisation.oci-containers.containers."changedetection-changedetection-puppet" = {
    image = "localhost/compose2nix/changedetection-changedetection-puppet";
    environment = {
      "MAX_CONCURRENT_CHROME_PROCESSES" = "2";
    };
    log-driver = "journald";
    extraOptions = [
      "--hostname=changedetection-puppet"
      "--memory=1073741824b"
      "--network-alias=changedetection-puppet"
      "--network=changedetection_default"
    ];
    rootless = { user = "podman"; };
  };
  systemd.services."docker-changedetection-changedetection-puppet" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
      RestartMaxDelaySec = lib.mkOverride 90 "1m";
      RestartSec = lib.mkOverride 90 "100ms";
      RestartSteps = lib.mkOverride 90 9;
    };
    after = [
      "docker-network-changedetection_default.service"
    ];
    requires = [
      "docker-network-changedetection_default.service"
    ];
    partOf = [
      "docker-compose-changedetection-root.target"
    ];
    wantedBy = [
      "docker-compose-changedetection-root.target"
    ];
  };

  # Networks
  systemd.services."docker-network-changedetection_default" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "docker network rm -f changedetection_default";
    };
    script = ''
      docker network inspect changedetection_default || docker network create changedetection_default
    '';
    partOf = [ "docker-compose-changedetection-root.target" ];
    wantedBy = [ "docker-compose-changedetection-root.target" ];
  };

  # Volumes
  systemd.services."docker-volume-changedetection_changedetection_data" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      docker volume inspect changedetection_data || docker volume create changedetection_data
    '';
    partOf = [ "docker-compose-changedetection-root.target" ];
    wantedBy = [ "docker-compose-changedetection-root.target" ];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."docker-compose-changedetection-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = [ "multi-user.target" ];
  };
}
