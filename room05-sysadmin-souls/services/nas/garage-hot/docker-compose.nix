
{ pkgs, lib, ... }:

{


  # Containers
  virtualisation.oci-containers.containers."garage-hot" = {
    image = "dxflrs/garage:v2.1.0";
    environment = {
      "GARAGE_CONFIG_FILE" = "/var/lib/garage/meta/garage.toml";
    };
    volumes = [
      "garage-hot-data:/var/lib/garage/data:rw"
      "garage-hot-meta:/var/lib/garage/meta:rw"
    ];
    ports = [
      "63005:3900/tcp"
      "63006:3902/tcp"
    ];
    log-driver = "journald";
    extraOptions = [
      "--network-alias=garage-hot"
      "--network=garage-hot_default"
    ];
    rootless = { user = "podman"; };
  };
  systemd.services."docker-garage-hot" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
      RestartMaxDelaySec = lib.mkOverride 90 "1m";
      RestartSec = lib.mkOverride 90 "100ms";
      RestartSteps = lib.mkOverride 90 9;
    };
    after = [
      "docker-network-garage-hot_default.service"
      "docker-volume-garage-hot_garage-hot-data.service"
      "docker-volume-garage-hot_garage-hot-meta.service"
    ];
    requires = [
      "docker-network-garage-hot_default.service"
      "docker-volume-garage-hot_garage-hot-data.service"
      "docker-volume-garage-hot_garage-hot-meta.service"
    ];
    partOf = [
      "docker-compose-garage-hot-root.target"
    ];
    wantedBy = [
      "docker-compose-garage-hot-root.target"
    ];
  };

  # Networks
  systemd.services."docker-network-garage-hot_default" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "docker network rm -f garage-hot_default";
    };
    script = ''
      docker network inspect garage-hot_default || docker network create garage-hot_default
    '';
    partOf = [ "docker-compose-garage-hot-root.target" ];
    wantedBy = [ "docker-compose-garage-hot-root.target" ];
  };

  # Volumes
  systemd.services."docker-volume-garage-hot_garage-hot-data" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      docker volume inspect garage-hot-data || docker volume create garage-hot-data
    '';
    partOf = [ "docker-compose-garage-hot-root.target" ];
    wantedBy = [ "docker-compose-garage-hot-root.target" ];
  };
  systemd.services."docker-volume-garage-hot_garage-hot-meta" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      docker volume inspect garage-hot_garage-hot-meta || docker volume create garage-hot_garage-hot-meta
    '';
    partOf = [ "docker-compose-garage-hot-root.target" ];
    wantedBy = [ "docker-compose-garage-hot-root.target" ];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."docker-compose-garage-hot-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = [ "multi-user.target" ];
  };
}
