
{ pkgs, lib, config, ... }:

{


  # Containers
  virtualisation.oci-containers.containers."bichon" = {
    image = "docker.io/rustmailer/bichon:2.0.3";
    volumes = [
      "bichon-config:/config:rw"
      "bichon-data:/data:rw"
    ];
    ports = [
      "63001:15630/tcp"
    ];
    user = "1000:1000";
    log-driver = "journald";
    extraOptions = [
      "--memory=1073741824b"
      "--network-alias=bichon"
      "--network=bichon_default"
    ];
    podman = {
      user = "podman";
    };
  };
  systemd.services."podman-bichon" = {
    serviceConfig = {
      User = "podman";
      Restart = lib.mkOverride 90 "no";
    };
    after = [
      "podman-network-bichon_default.service"
      "podman-volume-bichon_bichon-config.service"
      "podman-volume-bichon_bichon-data.service"
    ];
    requires = [
      "podman-network-bichon_default.service"
      "podman-volume-bichon_bichon-config.service"
      "podman-volume-bichon_bichon-data.service"
    ];
    partOf = [
      "podman-compose-bichon-root.target"
    ];
    wantedBy = [
      "podman-compose-bichon-root.target"
    ];
  };

  # Networks
  systemd.services."podman-network-bichon_default" = {
    path = [ pkgs.podman ];
    serviceConfig = {
      User = "podman";
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "podman network rm -f bichon_default";
    };
    script = ''
      podman network inspect bichon_default || podman network create bichon_default
    '';
    partOf = [ "podman-compose-bichon-root.target" ];
    wantedBy = [ "podman-compose-bichon-root.target" ];
  };

  # Volumes
  systemd.services."podman-volume-bichon_bichon-config" = {
    path = [ pkgs.podman ];
    serviceConfig = {
      User = "podman";
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      podman volume inspect bichon-config || podman volume create bichon-config
    '';
    partOf = [ "podman-compose-bichon-root.target" ];
    wantedBy = [ "podman-compose-bichon-root.target" ];
  };
  systemd.services."podman-volume-bichon_bichon-data" = {
    path = [ pkgs.podman ];
    serviceConfig = {
      User = "podman";
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      podman volume inspect bichon-data || podman volume create bichon-data
    '';
    partOf = [ "podman-compose-bichon-root.target" ];
    wantedBy = [ "podman-compose-bichon-root.target" ];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."podman-compose-bichon-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = [ "multi-user.target" ];
  };
}
