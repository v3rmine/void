
{ pkgs, lib, ... }:

{


  # Containers
  virtualisation.oci-containers.containers."bichon" = {
    image = "docker.io/rustmailer/bichon:2.0.3";
    environment = {
      "BICHON_ENCRYPT_PASSWORD_FILE" = "/config/key.txt";
      "BICHON_LOG_LEVEL" = "info";
      "BICHON_ROOT_DIR" = "/data";
    };
    volumes = [
      "bichon-config:/config:rw"
      "bichon-data:/data:rw"
    ];
    ports = [
      "63001:15630/tcp"
    ];
    #user = "1000:1000";
    log-driver = "journald";
    extraOptions = [
      "--memory=1073741824b"
      "--network-alias=bichon"
      "--network=bichon_default"
    ];
    rootless = { user = "podman"; };
  };
  systemd.services."docker-bichon" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "no";
    };
    after = [
      "docker-network-bichon_default.service"
      "docker-volume-bichon_bichon-config.service"
      "docker-volume-bichon_bichon-data.service"
    ];
    requires = [
      "docker-network-bichon_default.service"
      "docker-volume-bichon_bichon-config.service"
      "docker-volume-bichon_bichon-data.service"
    ];
    partOf = [
      "docker-compose-bichon-root.target"
    ];
    wantedBy = [
      "docker-compose-bichon-root.target"
    ];
  };

  # Networks
  systemd.services."docker-network-bichon_default" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "docker network rm -f bichon_default";
    };
    script = ''
      docker network inspect bichon_default || docker network create bichon_default
    '';
    partOf = [ "docker-compose-bichon-root.target" ];
    wantedBy = [ "docker-compose-bichon-root.target" ];
  };

  # Volumes
  systemd.services."docker-volume-bichon_bichon-config" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      docker volume inspect bichon-config || docker volume create bichon-config
    '';
    partOf = [ "docker-compose-bichon-root.target" ];
    wantedBy = [ "docker-compose-bichon-root.target" ];
  };
  systemd.services."docker-volume-bichon_bichon-data" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      docker volume inspect bichon-data || docker volume create bichon-data
    '';
    partOf = [ "docker-compose-bichon-root.target" ];
    wantedBy = [ "docker-compose-bichon-root.target" ];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."docker-compose-bichon-root" = {
    unitConfig = {
      ConditionUser = "podman";
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = [ "multi-user.target" ];
  };
}
