
{ pkgs, lib, ... }:

{


  # Containers
  virtualisation.oci-containers.containers."blog-hidden-website" = {
    image = "localhost/compose2nix/blog-hidden-website";
    log-driver = "journald";
    extraOptions = [
      "--network-alias=hidden-website"
      "--network=blog_default"
    ];
    rootless = { user = "podman"; };
  };
  systemd.services."docker-blog-hidden-website" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "no";
    };
    after = [
      "docker-network-blog_default.service"
    ];
    requires = [
      "docker-network-blog_default.service"
    ];
    partOf = [
      "docker-compose-blog-root.target"
    ];
    wantedBy = [
      "docker-compose-blog-root.target"
    ];
  };
  virtualisation.oci-containers.containers."blog-personal-website" = {
    image = "localhost/compose2nix/blog-personal-website";
    ports = [
      "63001:80/tcp"
    ];
    log-driver = "journald";
    extraOptions = [
      "--network-alias=personal-website"
      "--network=blog_default"
    ];
    rootless = { user = "podman"; };
  };
  systemd.services."docker-blog-personal-website" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "no";
    };
    after = [
      "docker-network-blog_default.service"
    ];
    requires = [
      "docker-network-blog_default.service"
    ];
    partOf = [
      "docker-compose-blog-root.target"
    ];
    wantedBy = [
      "docker-compose-blog-root.target"
    ];
  };
  virtualisation.oci-containers.containers."blog-tor-proxy" = {
    image = "containers.torproject.org/tpo/onion-services/onimages/tor:alpine";
    volumes = [
      "tor-data:/var/lib/tor:rw"
    ];
    user = "0:0";
    cmd = [ "--RunAsDaemon" "0" "--HiddenServiceDir" "/var/lib/tor/onion" "--HiddenServicePort" "80 hidden-website:80" "--HiddenServiceSingleHopMode" "1" "--HiddenServiceNonAnonymousMode" "1" "--SOCKSPort" "0" "--HiddenServiceMaxStreams" "50" "--HiddenServiceMaxStreamsCloseCircuit" "1" "--HiddenServiceNumIntroductionPoints" "6" ];
    dependsOn = [
      "blog-hidden-website"
    ];
    log-driver = "journald";
    extraOptions = [
      "--network-alias=tor-proxy"
      "--network=blog_default"
    ];
    rootless = { user = "podman"; };
  };
  systemd.services."docker-blog-tor-proxy" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "no";
    };
    after = [
      "docker-network-blog_default.service"
      "docker-volume-blog_tor-data.service"
    ];
    requires = [
      "docker-network-blog_default.service"
      "docker-volume-blog_tor-data.service"
    ];
    partOf = [
      "docker-compose-blog-root.target"
    ];
    wantedBy = [
      "docker-compose-blog-root.target"
    ];
  };

  # Networks
  systemd.services."docker-network-blog_default" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "docker network rm -f blog_default";
    };
    script = ''
      docker network inspect blog_default || docker network create blog_default
    '';
    partOf = [ "docker-compose-blog-root.target" ];
    wantedBy = [ "docker-compose-blog-root.target" ];
  };

  # Volumes
  systemd.services."docker-volume-blog_tor-data" = {
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      docker volume inspect tor-data || docker volume create tor-data
    '';
    partOf = [ "docker-compose-blog-root.target" ];
    wantedBy = [ "docker-compose-blog-root.target" ];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."docker-compose-blog-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = [ "multi-user.target" ];
  };
}
